# Local: copy this to .env. Railway: import these as service variables.
# Keep real tokens and SSH keys out of Git and Telegram.
MEDIA_BACKEND=raghu
RAGHU_PLANNER=clone
RAGHU_PLAN_ONLY=false
TELEGRAM_ENABLED=true
TELEGRAM_PRODUCTION_MODE=live
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Set true after configuring credentials and checking your Vast balance.
ALLOW_PAID_GENERATION=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Gemini is only needed if RAGHU_NARRATION_PROVIDER=gemini.
GEMINI_API_KEY=
VAST_API_KEY=
# Use a local key file OR the full private key text in a Railway variable.
VAST_SSH_KEY_PATH=
VAST_SSH_PRIVATE_KEY=
HF_TOKEN=
RAGHU_GPU=RTX_5090
# qwen2511 uses the pinned 30.2 GB FP8 package and 40-step image editing.
RAGHU_IMAGE_MODEL=flux
# ltx (approved), hunyuan15 (new 720p I2V test), or wan22
RAGHU_MOTION_MODEL=ltx
RAGHU_QUANTIZATION=nvfp4
RAGHU_LTX_END_FRAME=false
RAGHU_NARRATION_PROVIDER=chatterbox
# Use none for a silent test. This omits narration and the intro; background audio is controlled separately.
# Leave blank to use the bundled narrator reference automatically.
RAGHU_NARRATOR_REFERENCE=
# Leave blank to use the bundled intro/disclaimer automatically.
RAGHU_OPENING_PATH=
# Eligible Vast hosts are ranked by estimated job cost. Spending is uncapped.
YOUTUBE_PUBLISH_ENABLED=false

# No automatic score, effects or ambience. Only your newly supplied track is used.
RAGHU_BACKGROUND_AUDIO=true
# Leave blank for raw narration/dialogue only. Legacy BGM_FILE is ignored.
RAGHU_USER_BGM_FILE=
RAGHU_SOUND_EFFECTS=false
# Four music tracks and previews are bundled. Telegram asks which one to use.
# Narration is one consistent voice at the approved gain of 0.765; no character TTS.
